{
  "name": "el-paraiso-gonzalo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @epg/api dev\" \"pnpm --filter @epg/web dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @epg/api prisma:generate",
    "db:migrate": "pnpm --filter @epg/api prisma:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "onlyBuiltDependencies": [
      "@prisma/client"
    ]
  }
}
